# CampusFind 2.0 - Environment Configuration
# Copy this file to .env and adjust variables as per your local setup

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=campusfind_db
DB_PORT=3306

# JWT Authentication Secret & Expiration
JWT_SECRET=campusfind_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Frontend Origin for CORS (e.g. Live Server or static server)
FRONTEND_URL=http://127.0.0.1:5500

